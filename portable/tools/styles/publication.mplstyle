# provenance | 上游: D:\code\models\Tools\融合研究\融合研究-共享版\assets\publication.mplstyle | sha256: a6ce664d6c16c5e3c17b15686c014e4cbb37cff2c00f5403c658b7f28a51efb5 | 迁入: 2026-09-12 | 改动: 无
## 通用投稿级基础风格
## 来源: Light-skills project (light-figure-drawing)
## 无衬线、去 chart junk、矢量文字可编辑

# 字体
font.family: sans-serif
font.sans-serif: Arial, Helvetica, Liberation Sans
font.size: 10
axes.titlesize: 12
axes.labelsize: 10
legend.fontsize: 9
xtick.labelsize: 9
ytick.labelsize: 9

# 图形尺寸
figure.figsize: 6, 4
figure.dpi: 300
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.02

# 坐标轴
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
axes.spines.left: True
axes.spines.bottom: True
axes.labelpad: 4
axes.titlepad: 6

# 刻度
xtick.major.size: 4
xtick.major.width: 0.6
xtick.minor.size: 2
xtick.minor.width: 0.4
ytick.major.size: 4
ytick.major.width: 0.6
ytick.minor.size: 2
ytick.minor.width: 0.4
xtick.direction: out
ytick.direction: out
xtick.major.pad: 4
ytick.major.pad: 4

# 网格
axes.grid: True
grid.alpha: 0.3
grid.linestyle: --
grid.linewidth: 0.4

# 线条
lines.linewidth: 1.5
lines.markersize: 5
lines.markeredgewidth: 0.5

# 图例
legend.frameon: True
legend.fancybox: False
legend.edgecolor: '0.8'
legend.handlelength: 1.5
legend.handletextpad: 0.5
legend.columnspacing: 1.0

# 图像
image.cmap: RdBu_r

# 柱状图
patch.linewidth: 0.5
patch.edgecolor: white

# Okabe-Ito 色盲安全色环
# ⚠️ 必须用 RGB 元组，不能写 '#RRGGBB'：matplotlib 读 .mplstyle 时 _strip_comment()
#    会把第一个 '#' 之后全部当注释剥掉，十六进制色值会被静默截断（2026-10-17 实测）。
axes.prop_cycle : cycler('color', [(0.9020,0.6235,0.0000), (0.3373,0.7059,0.9137), (0.0000,0.6196,0.4510), (0.9412,0.8941,0.2588), (0.0000,0.4471,0.6980), (0.8353,0.3686,0.0000), (0.8000,0.4745,0.6549), (0.0000,0.0000,0.0000)])
